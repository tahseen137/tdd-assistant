# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-api-key-here

# Optional: Default AI model (gpt-4 or gpt-3.5-turbo)
# AI_MODEL=gpt-4

# Optional: Default package name for generated tests
# PACKAGE_NAME=com.example.myapp

# Optional: Default output directory for test files
# OUTPUT_DIRECTORY=src/test/java

# Optional: Test naming convention (should, given_when_then, test)
# TEST_NAMING_CONVENTION=should

# Optional: Spring Boot version (for annotation compatibility)
# SPRING_BOOT_VERSION=3.x
